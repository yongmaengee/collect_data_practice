# .env 템플릿 - 이 파일을 .env 로 복사해서 사용한다.
#   cp .env.example .env
# 실제 .env 는 .gitignore 로 제외되며 저장소에 올라가지 않는다.
# (이번 실습의 3개 API는 인증키가 없지만, 설정을 코드에서 분리하는 습관을 위해 동일하게 관리)

# 수집 대상 API 베이스 URL
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
COUNTRIES_URL=https://countries.dev/alpha
IP_API_URL=http://ip-api.com/json

# 조회 파라미터
LATITUDE=37.5665
LONGITUDE=126.9780
FORECAST_DAYS=3
TIMEZONE=Asia/Seoul
COUNTRY_CODE=KOR
TARGET_IP=8.8.8.8

# 네트워크 설정
TIMEOUT_SECONDS=10
MAX_RETRIES=2

# 인증키가 필요한 API를 추가할 경우 여기에 작성 (예시)
# WEATHER_API_KEY=여기에_키_입력
